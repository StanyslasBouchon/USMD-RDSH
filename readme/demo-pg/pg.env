# Settings of the "pg" cluster, signed and delivered with its service file
# (attached file, read by pg.sh). Every node of the USD receives this file:
# use passwords for this cluster only. No single quote in a password.
PG_REPL_PASSWORD=change-me-replication
PG_APP_PASSWORD=change-me-app
# Sources allowed to connect, space separated (pg_hba, scram-sha-256): the
# nodes (replication, balance VIP) and the clients.
PG_ALLOW="0.0.0.0/0"
# Health checks in a row without a primary before a replica promotes itself.
PG_PROMOTE_AFTER=3
